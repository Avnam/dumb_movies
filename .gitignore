# Photos, videos, songs and rendered movies are large and personal, and can be
# rebuilt from the sources, so they are not versioned. Keep them in work/.
work/
*.mp4
*.mov
*.mp3
*.m4a
*.wav
*.jpg
*.jpeg
*.png
*.heic
*.zip
__pycache__/
# face models are downloaded by setup.ps1 (checked by SHA-256)
models/

# Personal run records - kept on this PC, never uploaded:
# your movie log, picture choices (exclude/dwell) and manual zoom points.
RENDER_LOG.md
grow/
focus/
# edits files list photo names - keep them out of git wherever they are saved
*edits*.txt
my_*.txt
